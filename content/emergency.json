   {"es": "Ich brauche eine Apotheke.", "en": "I need a pharmacy."},
   {"es": "Ich nehme diese Medikamente.", "en": "I take these medicines."},
   {"es": "Ich bin schwanger.", "en": "I am pregnant."},
   {"es": "Er ist bewusstlos.", "en": "He is unconscious."}
  ]
 },
 {
  "title": "Lost, robbed or stuck",
  "phrases": [
