   {"es": "Bitte langsam. Ich verstehe nicht alles.", "en": "Slowly, please. I do not understand everything."},
   {"es": "Können Sie das aufschreiben?", "en": "Could you write that down?"}
  ]
 },
 {
  "title": "The numbers",
  "phrases": [
